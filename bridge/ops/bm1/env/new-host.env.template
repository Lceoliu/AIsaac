# bm1 environment template for a host without Docker (run as the system's user, e.g. root inside a container).
# Copy to <bm1>/bm1.env and fill the lane from the host's probe (bm1/probe_host.sh prints CPUs, NUMA nodes, GPUs and
# their NUMA affinity): nothing here may be guessed. Empty values mean "not pinned / not checked".
BM1_HOST_LABEL=                                   # e.g. host-name-lane0
BM1_MODE=direct
BM1_ROOT=/root/AIsaac/bm1                         # bm1 on the host (~/AIsaac per the coordinator)
BM1_IN=/root/AIsaac/bm1                           # direct: the same as BM1_ROOT
BM1_PY=/root/AIsaac/venv/bin/python               # the venv made by bm1/README.md's "from zero" list
BM1_GAME_RUNTIME=/root/AIsaac/isaac-abplus/runtime   # the AB+ runtime copied from the 8x3090 (make it read-only)
BM1_CPUSET=                                       # from the probe (the lane's CPUs); empty: no pinning
BM1_MEMS=                                         # from the probe (the lane's NUMA node); empty: none
BM1_GPUS_OK=                                      # from the probe and the coordinator's lane plan, e.g. 0,1
BM1_MEM=                                          # per-run memory limit (one split shard measured 44.9 GB at peak)
BM1_PIDS=4096
BM1_LOCK=/root/AIsaac/bm1/LOCK_lane0
BM1_SESSION=bm1-a1
BM1_GPU_EXPECT=                                   # how many GPUs nvidia-smi -L must list (from the probe)
BM1_NSYS=                                         # optional (nsys's CUDA trace failed with cu128 on the 8x3090)
