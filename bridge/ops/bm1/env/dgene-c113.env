# bm1 environment: the 8x3090 dgene (2026-11-17, C113; the user: "用184，别用GPU5"). Copied to <bm1>/bm1.env.
# Hardware: 2x Gold 6146 (node0 = CPUs 0-11,24-35, node1 = 12-23,36-47), 125 GiB, 8x RTX 3090 (GPUs 0-3 PCI 1A/1B/3D/3E,
# 4-7 PCI 88/89/B1/B2). Ours: GPUs 1, 2, 3, 4 only. GPU 5 (PCI 0000:89:00.0) is NEVER used: run.sh and preflight refuse
# any job whose GPU list holds index 5 or that UUID. GPUs 6/7 are another tenant's; GPU 0 only with the coordinator's yes.
# Limits of this host (the coordinator): containers aisaac-bench-*, CPUs 40 and memory 64 GiB in all, no privileges,
# no seccomp change, no host setting, nothing installed, no prune, other tenants' containers / images / volumes untouched.
BM1_HOST_LABEL=dgene-c113
BM1_MODE=docker
BM1_ROOT=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide/bm1
BM1_DOCKER_BASE=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide   # mounted as /bench
BM1_IMAGE=aisaac-bench:20261019
BM1_IN=/bench/bm1
BM1_PY=/bench/home/isaac-abplus/.venv/bin/python
BM1_GAME_RUNTIME=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide/home/isaac-abplus/runtime
BM1_CPUSET=0-7,24-31                              # non-timed jobs (gates, tests, D1): 16 threads of node0
BM1_MEMS=0
BM1_LOCKDIR=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide/bm1/locks   # one reader-writer lock (common.sh)
BM1_GPUS_OK=1,2,3,4                               # the user / coordinator 2026-11-17: GPUs 1-4 only
BM1_GPU_FORBID=5                                  # never, under any index list (run.sh / preflight refuse)
BM1_GPU_FORBID_UUID=GPU-9a49bc46-f76b-dba0-6370-1b9030e16648   # GPU 5, PCI 0000:89:00.0
BM1_GPU_FREE_MB=500
BM1_MEM=64g                                       # one container's limit; the host's cap for us is 64 GiB in all
BM1_PIDS=4096
BM1_SESSION=bm1-c113
BM1_GPU_EXPECT=8
BM1_SMI_TIMEOUT=20                                # every nvidia-smi call under timeout (s)
# run directories (train_guard.sh, c108_guard.sh, d1_run.sh, c113_*): results under bm1/c113 (the coordinator)
BM1_TRAIN=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide/bm1   # <parent>/<name> below it on the host
BM1_TRAIN_IN=/bench/bm1                           # the same as the container sees it
BM1_DISK=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide        # free-space checks
BM1_TRASH=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide/bm1/trash   # every deletion: a move into <date>/
BM1_TRASH_IN=/bench/bm1/trash
BM1_TRASH_GIO=0
BM1_NSYS=
