# bm1 environment: the 8x3090 dgene, this session's lane on node1 (2026-11-11; cpp-actor's lane is node0 with its own
# bm1 directory and bm1/locks). Its own bm1 root (bm1n1: scripts, trees, reports, home), its own lock directory; the
# shared venv, runtime, pydeps and payloads read only. GPUs: 4 (actor) and 3 (learner; GPU 3 hangs on node0: the learner
# card crosses NUMA). Copied to <bm1n1>/bm1.env at deployment.
BM1_HOST_LABEL=dgene-8x3090-node1
BM1_MODE=docker
BM1_ROOT=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide/bm1n1
BM1_DOCKER_BASE=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide
BM1_IMAGE=aisaac-bench:20261019
BM1_IN=/bench/bm1n1
BM1_PY=/bench/home/isaac-abplus/.venv/bin/python
BM1_GAME_RUNTIME=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide/home/isaac-abplus/runtime
BM1_CPUSET=12-23,36-47                            # node1: 12 cores / 24 threads (siblings i and i+24)
BM1_MEMS=1
BM1_TIMED_CPUSET=12-23,36-47                      # timed runs: the same node (the other node is cpp-actor's)
BM1_TIMED_MEMS=1
BM1_GPUS_OK=3,4
BM1_MEM=50g
BM1_PIDS=4096
BM1_LOCKDIR=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide/bm1/locks-node1   # node1's reader-writer lock
BM1_SESSION=bm1-a1n1
BM1_GPU_EXPECT=8
BM1_TRASH=
BM1_NSYS=
