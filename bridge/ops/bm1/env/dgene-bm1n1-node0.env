# bm1 environment: the 8x3090 dgene, this session's bm1n1 directory on node0 with GPUs 1 (actor) + 2 (learner), taking
# turns with cpp-actor on the same lane (its lock directory bm1/locks; 2026-11-11: GPUs 0, 3, 4, 5 another tenant's,
# 6, 7 tyt's). The same configuration as the 11-10 split runs on this host (split-tl, 235.9x). Copied to
# <bm1n1>/bm1.env at deployment.
BM1_HOST_LABEL=dgene-8x3090-bm1n1-node0
BM1_MODE=docker
BM1_ROOT=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide/bm1n1
BM1_DOCKER_BASE=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide
BM1_IMAGE=aisaac-bench:20261019
BM1_IN=/bench/bm1n1
BM1_PY=/bench/home/isaac-abplus/.venv/bin/python
BM1_GAME_RUNTIME=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide/home/isaac-abplus/runtime
BM1_CPUSET=0-11,24-35                             # node0: 12 cores / 24 threads (siblings i and i+24)
BM1_MEMS=0
BM1_TIMED_CPUSET=0-11,24-35
BM1_TIMED_MEMS=0
BM1_GPUS_OK=1,2
BM1_MEM=64g
BM1_PIDS=4096
BM1_LOCKDIR=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide/bm1/locks   # cpp-actor's: the two sessions take turns
BM1_LOCK=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide/bm1n1/LOCK_node0
BM1_SESSION=bm1-a1n1
BM1_GPU_EXPECT=8
BM1_TRASH=
BM1_NSYS=
