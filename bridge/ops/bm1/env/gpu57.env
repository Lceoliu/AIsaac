# bm1 environment: gpu57 (10.19.136.57), bare-metal host, we are root; a shared lab: other tenants' containers may use
# any GPU and CPU at any time. Hardware from the coordinator's read-only probe (2026-11-11 04:08 UTC): 2x E5-2667 v3
# (16 cores / 32 threads; node0 = CPUs 0-7,16-23, node1 = 8-15,24-31), 251 GB, 8x RTX 3090 all on NUMA node0,
# driver 560.28.03, Docker 24.0.7 with the nvidia runtime, cgroup v1. Copied to /root/AIsaac/bm1/bm1.env.
BM1_HOST_LABEL=gpu57-lane0
BM1_MODE=docker                                   # (direct mode is not used on this host: the coordinator's rule)
BM1_ROOT=/root/AIsaac/bm1
BM1_DOCKER_BASE=/root/AIsaac                      # mounted as /bench: the same layout as the 8x3090's cpu-wide
BM1_IMAGE=aisaac-bench:20261019
BM1_IN=/bench/bm1
BM1_PY=/bench/home/isaac-abplus/.venv/bin/python  # the 8x3090's venv, copied as it was (torch 2.7.1+cu128)
BM1_GAME_RUNTIME=/root/AIsaac/home/isaac-abplus/runtime
BM1_CPUSET=0-7,16-23                              # X1: node0's 16 threads (X2 overrides with CPUSET=0-31 MEMS=)
BM1_MEMS=0
BM1_GPUS_OK=1,2,3,4,5,6,7                         # not GPU 0 (another tenant's process on it); each start checks the card is free
BM1_GPU_FREE_MB=500
BM1_MEM=64g
BM1_PIDS=4096
BM1_LOCK=/root/AIsaac/bm1/LOCK_lane0
BM1_SESSION=bm1-a1
BM1_GPU_EXPECT=8
BM1_TRASH=/root/AIsaac/trash
BM1_NSYS=
