# bm1 environment: the 8x3090 dgene, lane node0 (BM1 rounds 1-5). Copied to <bm1>/bm1.env at deployment.
# Every bm1 script reads only this file for host facts; nothing host-specific is written in the scripts.
BM1_HOST_LABEL=dgene-8x3090-node0
BM1_MODE=docker                                   # docker (this host) | direct (no Docker: the current system)
BM1_ROOT=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide/bm1   # bm1 on the host (scripts, trees, reports, home)
BM1_DOCKER_BASE=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide   # (docker) mounted as /bench
BM1_IMAGE=aisaac-bench:20261019                   # (docker) Ubuntu 22.04, Python 3.10.12, g++ 11.4, xvfb
BM1_IN=/bench/bm1                                 # bm1 as the runner sees it (direct: = BM1_ROOT)
BM1_PY=/bench/home/isaac-abplus/.venv/bin/python  # the interpreter as the runner sees it (shared venv + bm1/pydeps)
BM1_GAME_RUNTIME=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide/home/isaac-abplus/runtime   # AB+ runtime (read-only)
# the lane (from the host's probe: 2x Gold 6146, node0 = CPUs 0-11,24-35 + GPUs 0-3; GPU 0, 6, 7 other tenants')
BM1_CPUSET=0-11,24-35                             # empty: no CPU pinning
BM1_MEMS=0                                        # memory node(s); empty: none
BM1_GPUS_OK=1,2,3                                 # the GPUs this lane may use
BM1_MEM=64g                                       # memory limit per run (docker --memory; direct: cgroup or memguard)
BM1_PIDS=4096                                     # (docker) pids limit; nsys_update.sh raises it
BM1_LOCK=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide/bm1/LOCK_node0
BM1_SESSION=bm1-a1
BM1_GPU_EXPECT=8                                  # preflight: GPUs nvidia-smi -L must list
BM1_NSYS=/bench/bm1/tools/nsys-2023.4.4/opt/nvidia/nsight-systems/2023.4.4/bin/nsys   # (as the runner sees it)
