# bm1 environment: the 8x3090 dgene after its reboot (2026-11-11), the cpp-actor lane for M1's timed pair: GPUs 1,2 on
# node0 (24 threads), the coordinator's plan (GPU 5 fell off the bus before the reboot: the 4,5 lane is paused). A
# second bm1 directory, .../bm1/cpp (its own trees/, reports/, home/ and game dir, these scripts); the image, the shared
# venv, the runtime, bm1/pydeps and bm1/payloads read-only. Copied to .../bm1/cpp/bm1.env.
BM1_HOST_LABEL=dgene-8x3090-cpp
BM1_MODE=docker
BM1_ROOT=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide/bm1/cpp
BM1_DOCKER_BASE=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide   # mounted as /bench
BM1_IMAGE=aisaac-bench:20261019
BM1_IN=/bench/bm1/cpp
BM1_PY=/bench/home/isaac-abplus/.venv/bin/python
BM1_GAME_RUNTIME=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide/home/isaac-abplus/runtime
BM1_CPUSET=0-11,24-35                             # node0's 24 threads (2x Gold 6146: node0 = CPUs 0-11,24-35 + GPUs 0-3)
BM1_MEMS=0
BM1_GPUS_OK=1,2                                   # actor 1, learner 2; not 0, 6, 7 (other tenants), not 4, 5 (paused)
BM1_GPU_FREE_MB=500
BM1_MEM=64g
BM1_PIDS=4096
BM1_LOCKDIR=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide/bm1/locks   # the host's reader-writer lock
BM1_SESSION=bm1-cpp
BM1_GPU_EXPECT=8
BM1_TRASH=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide/bm1/cpp/trash
BM1_NSYS=/bench/bm1/tools/nsys-2023.4.4/opt/nvidia/nsight-systems/2023.4.4/bin/nsys
BM1_NAME=aisaac-bench-bm1-cpp
BM1_PYTHONPATH=/bench/bm1/pydeps:/bench/bm1/cpp/pydeps
BM1_RUNTIME_LINK=../../../../home/isaac-abplus/runtime
BM1_PAYLOADS=/bench/bm1/payloads
