# bm1 environment: gpu57 (10.19.136.57), the cpp-actor lane (the coordinator's lane plan, 2026-11-11). A second bm1
# directory: /root/AIsaac/bm1/cpp (its own trees/, reports/, home/ and game dir, ops = these scripts); the image, the
# shared venv, the game runtime, bm1/pydeps and bm1/payloads are A1's, used read-only. Copied to /root/AIsaac/bm1/cpp/bm1.env.
# Host facts as env/gpu57.env (2x E5-2667 v3, node0 = CPUs 0-7,16-23, node1 = 8-15,24-31, 8x3090 on node0, cgroup v1).
BM1_HOST_LABEL=gpu57-cpp
BM1_MODE=docker
BM1_ROOT=/root/AIsaac/bm1/cpp
BM1_DOCKER_BASE=/root/AIsaac                      # mounted as /bench (this lane's directory is /bench/bm1/cpp)
BM1_IMAGE=aisaac-bench:20261019
BM1_IN=/bench/bm1/cpp
BM1_PY=/bench/home/isaac-abplus/.venv/bin/python  # A1's venv, read-only
BM1_GAME_RUNTIME=/root/AIsaac/home/isaac-abplus/runtime
BM1_CPUSET=8-15,24-31                             # untimed jobs (build, gates, TSAN): node1's 16 threads
BM1_MEMS=1
BM1_TIMED_CPUSET=0-31                             # timed runs: every thread, under the exclusive lock
BM1_TIMED_MEMS=
BM1_GPUS_OK=3,4,6                                 # this lane's GPUs (the lane-GPU work: actor / lane / learner, coordinator 2026-11-11); each start checks they are free
BM1_GPU_FREE_MB=500
BM1_MEM=64g
BM1_PIDS=4096
BM1_LOCKDIR=/root/AIsaac/bm1/locks                # the host's one reader-writer lock, the same directory as A1's
BM1_SESSION=bm1-cpp                               # (A1: bm1-a1)
BM1_GPU_EXPECT=8
BM1_TRASH=/root/AIsaac/bm1/cpp/trash
BM1_NSYS=
BM1_NAME=aisaac-bench-bm1-cpp                     # container names aisaac-bench-bm1-cpp-<purpose>
BM1_PYTHONPATH=/bench/bm1/pydeps:/bench/bm1/cpp/pydeps   # A1's pydeps first, then this lane's (empty unless needed)
BM1_RUNTIME_LINK=../../../../home/isaac-abplus/runtime   # from bm1/cpp/home/isaac-abplus to /bench/home/isaac-abplus/runtime
BM1_PAYLOADS=/bench/bm1/payloads                  # A1's b45 payloads (read-only)
