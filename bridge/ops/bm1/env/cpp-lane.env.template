# bm1 environment of the cpp-actor lane (a second bm1 directory on the same host, e.g. <bm1>/cpp or ~/AIsaac/bm1-cpp,
# with its own bm1.env: its own trees/, reports/, home/ and game dir, its own lock and container names). Start from the
# host's lane-0 file (env/dgene-8x3090.env or the new host's) and change only what differs below; fill the lane from
# the coordinator's lane plan (nothing guessed).
BM1_HOST_LABEL=                                   # e.g. <host>-cpp
BM1_IN=                                           # this bm1 directory as the runner sees it (docker: /bench/.../cpp)
BM1_CPUSET=                                       # the lane's CPUs
BM1_MEMS=                                         # its memory node
BM1_GPUS_OK=                                      # its GPUs (actor, learner)
BM1_LOCK=                                         # its own lock file, e.g. <bm1>/LOCK_cpp
BM1_SESSION=bm1-cpp
BM1_NAME=aisaac-bench-bm1-cpp                     # container name prefix (default aisaac-bench-bm1-a1)
BM1_PYTHONPATH=                                   # the shared pydeps first, then this lane's: <bm1 in>/pydeps:<this in>/pydeps
BM1_RUNTIME_LINK=                                 # (docker) the runtime link of deploy.sh abphome, relative to
                                                  # <this>/home/isaac-abplus (one more ../ per directory level below bm1)
