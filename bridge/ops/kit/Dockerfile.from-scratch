# DOCUMENTATION ONLY -- not built. Rebuilds the kit image's environment from public sources if the base image
# aisaac-bench:20261019 is ever lost. Needs the internet (apt, download.pytorch.org, PyPI); the kit itself is built
# offline by kit_build.sh. Versions are the exact ones of kit-20261111.1:
#   apt: dpkg-query -W of the base image (kit_build.sh, build-kit-20261111.1/dpkg-base.txt, 2026-11-11)
#   pip: the effective package set of the kit image (kit-20261111.1.packages.txt, 55 packages) =
#        bridge/ops/bm1/env/requirements-bm1.txt + the venv-only packages listed at its end + pip/setuptools
# The base: the old image's env says CUDA_VERSION=12.2.2, NV_CUDNN_VERSION=8.9.6.50 and carries the -dev packages
# (libnpp-dev, libcublas-dev, LIBRARY_PATH=.../stubs), i.e. NVIDIA's cudnn8-devel image on Ubuntu 22.04 (inferred
# from the env, the original Dockerfile is not available). torch brings its own CUDA 12.8 / cuDNN 9.7 libraries, so
# the image's CUDA 12.2 toolkit is not what training uses.
FROM nvidia/cuda:12.2.2-cudnn8-devel-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3.10=3.10.12-1~22.04.18 python3.10-dev=3.10.12-1~22.04.18 python3.10-venv=3.10.12-1~22.04.18 \
      python3-pip=22.0.2+dfsg-1ubuntu0.7 \
      build-essential=12.9ubuntu3 gcc=4:11.2.0-1ubuntu1 g++=4:11.2.0-1ubuntu1 \
      gcc-11=11.4.0-1ubuntu1~22.04 g++-11=11.4.0-1ubuntu1~22.04 \
      xvfb=2:21.1.4-2ubuntu1.7~22.04.16 xauth=1:1.1-1build2 \
      util-linux=2.37.2-4ubuntu3 procps=2:3.3.17-6ubuntu2.1 \
      git=1:2.34.1-1ubuntu1.17 curl=7.81.0-1ubuntu1.30 wget=1.21.2-2ubuntu1.4 ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
# (numactl, sysstat and zstd are NOT in the base image either; bm1 does not need them inside the container)
RUN python3.10 -m venv /opt/aisaac/venv \
 && /opt/aisaac/venv/bin/pip install --no-cache-dir pip==26.2.1 \
 && /opt/aisaac/venv/bin/pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cu128 torch==2.7.1+cu128 \
 && /opt/aisaac/venv/bin/pip install --no-cache-dir \
      triton==3.3.1 \
      nvidia-cublas-cu12==12.8.3.14 nvidia-cuda-cupti-cu12==12.8.57 nvidia-cuda-nvrtc-cu12==12.8.61 \
      nvidia-cuda-runtime-cu12==12.8.57 nvidia-cudnn-cu12==9.7.1.26 nvidia-cufft-cu12==11.3.3.41 \
      nvidia-cufile-cu12==1.13.0.11 nvidia-curand-cu12==10.3.9.55 nvidia-cusolver-cu12==11.7.2.55 \
      nvidia-cusparse-cu12==12.5.7.53 nvidia-cusparselt-cu12==0.6.3 nvidia-nccl-cu12==2.26.2 \
      nvidia-nvjitlink-cu12==12.8.61 nvidia-nvtx-cu12==12.8.55 \
      numpy==2.2.6 zstandard==0.25.0 lz4==4.4.5 pytest==9.2.0 iniconfig==2.3.1 pluggy==1.7.0 exceptiongroup==1.3.1 \
      tomli==2.5.0 pygments==2.21.0 py-spy==0.4.3 cloudpickle==3.1.2 Farama-Notifications==0.0.6 filelock==3.32.3 \
      fsspec==2026.7.0 gymnasium==1.2.3 Jinja2==3.1.6 MarkupSafe==3.0.3 mpmath==1.3.0 networkx==3.4.2 packaging==26.3 \
      psutil==7.0.0 sympy==1.14.0 typing_extensions==4.16.0 \
      contourpy==1.3.2 cycler==0.12.1 fonttools==4.65.0 kiwisolver==1.5.1 matplotlib==3.10.9 pandas==2.3.3 \
      pillow==12.3.0 pyparsing==3.3.3 python-dateutil==2.9.0.post0 pytz==2026.3.post1 sb3_contrib==2.7.1 six==1.17.0 \
      stable_baselines3==2.7.1 tzdata==2026.4
# setuptools 59.6.0 is what python3.10 -m venv brings on Ubuntu 22.04 (same as the kit's venv).
# The kit has no separate pydeps here: one venv holds the same effective package set (numpy 2.2.6, zstandard 0.25.0).
ENV VIRTUAL_ENV=/opt/aisaac/venv PATH=/opt/aisaac/venv/bin:/usr/local/nvidia/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /workspace
ENTRYPOINT ["/bin/bash"]
CMD ["-c", "exec /opt/aisaac/venv/bin/python -V"]
