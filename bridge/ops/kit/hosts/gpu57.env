# kit host file: gpu57 (10.19.136.57, ssh port 15654, root on a shared bare-metal lab host). Read by kit_common.sh
# when `hostname` = gpu57. Ours on this host: only /root/AIsaac/, images aisaac-bench:*, containers aisaac-bench-*.
KIT_HOST=gpu57
KIT_ROOT=/root/AIsaac
KIT_LOCKDIR=/root/AIsaac/bm1/locks   # the host's one reader-writer lock (bm1/common.sh), shared with A1 and cpp-actor
KIT_CPUSET=8-15,24-31                # node1 (every GPU of this host is on node0)
KIT_MEMS=1
KIT_MEM=16g
KIT_GPU_EXPECT=8
KIT_SMOKE_GPUS="6 7"                 # 0 another tenant's; A1 1,2 (5 probes); cpp-actor 3,4
KIT_TRASH=/root/AIsaac/trash
