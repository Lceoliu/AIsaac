# kit host file: the 8x3090 (hostname dgene, 10.19.136.184, user runaiwusheng). Read by kit_common.sh when
# `hostname` = dgene. Facts: HOSTS.md. No credentials here or anywhere in the kit.
KIT_HOST=dgene-8x3090
KIT_ROOT=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide     # <ROOT>: kit/ (archives), data/ (unpacked), bm1/
KIT_LOCKDIR=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide/bm1/locks   # the bm1 reader-writer lock (common.sh)
KIT_CPUSET=12-23,36-47        # NUMA node1: the kit's heavy steps (node0 = the bm1 lanes)
KIT_MEMS=1
KIT_MEM=16g                   # memory cap of every kit container
KIT_GPU_EXPECT=8
KIT_SMOKE_GPUS="3 4"          # doctor's CUDA smoke: the first of these with no process (never 0, 5, 6, 7)
KIT_TRASH=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide/kit/trash
# build sources (kit_build.sh; only the build host has them)
KIT_BASE_IMAGE=aisaac-bench:20261019
KIT_SRC_VENV=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide/home/isaac-abplus/.venv
KIT_SRC_PYDEPS=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide/bm1/pydeps
KIT_SRC_RUNTIME=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide/home/isaac-abplus/runtime
KIT_SRC_TOOLS=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide/home/isaac-abplus/tools
KIT_SRC_PAYLOADS=/home/runaiwusheng/aisaac-bench-20261019/cpu-wide/bm1/payloads/b45-payloads2
KIT_SRC_CKPT=/home/runaiwusheng/aisaac-bench-20261019/checkpoints/c99-segment2-final.pt
# the venv / pydeps paths the original scripts and venv were made with (rewritten to /opt/aisaac/venv in the image)
KIT_OLD_VENV_PATHS="/home/rhythmo/isaac-abplus/.venv /bench/home/isaac-abplus/.venv /home/runaiwusheng/aisaac-bench-20261019/cpu-wide/home/isaac-abplus/.venv"
